<script>
let speechParts = [];
let currentPart = 0;
let isReading = false;
let isPaused = false;
let readingRun = 0;

function startReading() {
    if (!('speechSynthesis' in window)) {
        alert("المتصفح لا يدعم خاصية القراءة الصوتية.");
        return;
    }

    window.speechSynthesis.cancel();

    const content = document.querySelector(".container").innerText;
    speechParts = content.match(/[^.!؟?\n]+[.!؟?]?/g) || [];

    currentPart = 0;
    isReading = true;
    isPaused = false;
    readingRun++;

    speakNext(readingRun);
}

function speakNext(runId) {
    if (runId !== readingRun || !isReading || isPaused) {
        return;
    }

    if (currentPart >= speechParts.length) {
        isReading = false;
        return;
    }

    const utterance = new SpeechSynthesisUtterance(
        speechParts[currentPart]
    );

    utterance.lang = "ar";
    utterance.rate = 0.9;
    utterance.pitch = 1;

    utterance.onend = function () {
        if (runId !== readingRun || !isReading || isPaused) {
            return;
        }

        currentPart++;
        speakNext(runId);
    };

    utterance.onerror = function () {
        if (runId !== readingRun || !isReading || isPaused) {
            return;
        }

        currentPart++;
        speakNext(runId);
    };

    window.speechSynthesis.speak(utterance);
}

function pauseReading() {
    if (!isReading) {
        return;
    }

    if (isPaused) {
        isPaused = false;
        window.speechSynthesis.resume();
        return;
    }

    isPaused = true;
    window.speechSynthesis.pause();
}

function stopReading() {
    readingRun++;
    isReading = false;
    isPaused = false;
    currentPart = 0;

    if ('speechSynthesis' in window) {
        window.speechSynthesis.cancel();
    }
}
</script>

