            padding: 15px;
        }

        .container {
            max-width: 850px;
            margin: 0 auto;
        }

        header {
            background: #1565c0;
            color: white;
            text-align: center;
            padding: 22px 15px;
            border-radius: 15px;
            margin-bottom: 20px;
        }

        header h1 {
            font-size: 24px;
            margin: 0 0 8px;
        }

        header p {
            margin: 0;
        }

        .intro,
        .question-card {
            background: white;
            padding: 18px;
            border-radius: 12px;
            margin-bottom: 18px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
        }

        .intro h2,
        .question-card h2 {
            color: #1565c0;
            margin-top: 0;
        }

        .question-card h2 {
            font-size: 20px;
        }

        .question-text {
            font-weight: bold;
            margin-bottom: 15px;
        }

        /* تنسيق الصور */
        .lesson-image {
            display: block;
            width: 100%;
            max-width: 450px;
            height: auto;
            max-height: 350px;
            object-fit: contain;
            margin: 20px auto;
            border-radius: 10px;
        }

        .answer-button {
            background: #1565c0;
            color: white;
            border: none;
            padding: 11px 18px;
            border-radius: 8px;
            font-size: 16px;
            cursor: pointer;
            font-family: inherit;
        }

        .answer-button:hover {
            background: #0d47a1;
        }

        .answer {
            display: none;
            background: #e8f5e9;
            border-right: 5px solid #2e7d32;
            padding: 15px;
            margin-top: 15px;
            border-radius: 8px;
        }

        .answer h3 {
            color: #2e7d32;
            margin-top: 0;
        }

        .answer ul,
        .answer ol {
            padding-right: 22px;
        }

        .table-box {
            width: 100%;
            overflow-x: auto;
            margin-top: 12px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: white;
            min-width: 280px;
        }

        th,
        td {
            border: 1px solid #cbd5e1;
            padding: 10px;
            text-align: center;
        }

        th {
            background: #e3f2fd;
            color: #0d47a1;
        }

        .english {
            direction: ltr;
