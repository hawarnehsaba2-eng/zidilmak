                font-size: 21px;
            }

            .question-card h2 {
                font-size: 18px;
            }

            .intro,
            .question-card {
                padding: 14px;
            }

            .lesson-image {
                max-width: 100%;
                max-height: 300px;
            }
        }
    </style>
</head>

<body>

<div class="container">

    <header>
